OPENROUTER_API_KEY=
OPENROUTER_MODEL=            # main model (claims and verdict); must support JSON output
OPENROUTER_VISION_MODEL=     # optional; falls back to OPENROUTER_MODEL
OPENROUTER_FAST_MODEL=       # optional; cheaper model for reading each source (most of the calls)
BRAVE_API_KEY=               # optional
GOOGLE_FACTCHECK_API_KEY=    # optional
WHISPER_MODEL=small
MAX_VIDEO_MINUTES=10
SOURCE_URL=https://github.com/bramenn/contraste  # AGPL-3.0: link to the source of the version you run
PUBLIC_BASE_URL=http://localhost:8080
DEMO_MODE=false              # true = serve the sample case without calling any API
ADMIN_PASSWORD=
PUBLISH_MIN_SOURCES=3
POSTGRES_PASSWORD=           # database password (docker-compose creates the database with it)
MAX_CONCURRENT_CHECKS=3      # checks running at once PER WORKER (pods run WEB_WORKERS of them); the rest wait in line
WEB_WORKERS=4                # processes serving the site (one per core you want to use)

# --- Accounts -------------------------------------------------------------------------------
# Resend (recommended): SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASSWORD=<Resend API key>.
# The sender domain must be verified in Resend.
SMTP_HOST=                   # empty = the sign-in link is written to the log (development only)
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Contraste <no-responder@tu-dominio.co>
GOOGLE_OAUTH_CLIENT_ID=      # optional; redirect URI: {PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_SECRET=
TURNSTILE_SITE_KEY=          # Cloudflare Turnstile; empty = no captcha (development only)
TURNSTILE_SECRET_KEY=

# --- Limits (Contraste is free) ---------------------------------------------------------------
FREE_MONTHLY_CREDITS=5       # checks per account per month; starting value, editors change it in /admin/negocio
DAILY_CHECKS=5               # checks per account per day; starting value, editors change it in /admin/negocio

# --- Cost protection ------------------------------------------------------------------------
DAILY_SPEND_LIMIT_USD=5      # model spend per day: when reached, new checks pause until tomorrow
FORWARDED_ALLOW_IPS=           # "*" behind Cloudflare Tunnel or a load balancer, so per-IP limits see the real IP
ADMIN_ALLOWED_IPS=            # optional: comma-separated IPs allowed into /admin (behind a proxy, needs FORWARDED_ALLOW_IPS)
BIND_ADDR=127.0.0.1           # 0.0.0.0 exposes port 8080 to your local network
DEEP_DEPTH=2                  # follow documents/sources cited by useful pages, this many hops
DEEP_MAX_PAGES=8              # extra pages per check from following citations
CROSS_MIN_SIMILARITY=0.6      # how close another check must be to receive cross-validation
MARKETS=true                  # dollar, coffee, gold and oil in the masthead, from their sources every 30 min
ORIGIN_SECRET=                # secret header X-Contraste-Origin added by a Cloudflare Transform Rule; blocks direct access and enables CF-Connecting-IP
GATE=true                     # entry gate: relevance to Colombia (plus global topics) and prompt-injection classifier
GATE_MODEL=typesafe/jev-1.13   # gate classifier on OpenRouter's Decisions API (Jev); empty = the fast chat model
